FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Ubuntu 24.04 ships Qt 6.4 and CMake 3.28, enough for the Qt6-only build.
# qt-extra, qcodeedit, toml++ and textviewers are fetched by CMake during the
# build (FetchContent), so only distribution packages are installed here.
RUN apt-get update && apt-get install -y \
    build-essential \
    debhelper \
    devscripts \
    cmake \
    git \
    ca-certificates \
    g++ \
    qt6-base-dev \
    qt6-qpa-plugins \
    libgl1-mesa-dev \
    libicu-dev \
    libarchive-dev \
    libbotan-2-dev \
    libgtest-dev \
    nlohmann-json3-dev \
    pkg-config \
    librsvg2-bin \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
